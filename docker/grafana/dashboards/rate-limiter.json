  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Requests / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(rate_limit_checks_total[1m]))",
          "legendFormat": "checks/sec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Allowed vs Rejected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(rate_limit_allowed_total[1m]))",
          "legendFormat": "allowed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rate_limit_rejected_total[1m]))",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Check latency P50 / P95 / P99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rate_limit_check_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rate_limit_check_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rate_limit_check_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Redis operation latency P95 / P99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(redis_operation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(redis_operation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "Policy cache hit / miss rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(policy_cache_hits_total[5m])) / clamp_min(sum(rate(policy_cache_hits_total[5m])) + sum(rate(policy_cache_misses_total[5m])), 1e-9)",
          "legendFormat": "hit rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(policy_cache_misses_total[5m])) / clamp_min(sum(rate(policy_cache_hits_total[5m])) + sum(rate(policy_cache_misses_total[5m])), 1e-9)",
          "legendFormat": "miss rate",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "title": "Top rejected policies",
      "type": "bargauge",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "targets": [
        {
          "expr": "sum by (policy) (increase(rate_limit_rejected_total[15m]))",
          "legendFormat": "{{policy}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
